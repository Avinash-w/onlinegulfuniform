# Public Razorpay Key ID (test or live). Never put the secret key here.
# Dashboard → Settings → API Keys → Generate Test Key
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Optional — Unsplash Access Key for Admin "Find Product Image"
# Free registration: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=

# Core PHP API base (no trailing slash)
VITE_API_BASE=http://localhost/juneberry/api
